// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  WAKIF
  NADZIR
  ADMIN
  PETUGAS_LAPANGAN
}

enum NadzirKategori {
  PERSEORANGAN
  ORGANISASI
  BADAN_HUKUM
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum NadzirDocumentType {
  KTP
  SERTIFIKAT_BWI
}

enum WaqfType {
  HABIS_PAKAI
  PRODUKTIF_KEKAL
}

enum WaqfStatus {
  DRAFT
  LIVE
  SELESAI
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  DISBURSED
}

enum TransactionType {
  WAKAF
  ZAKAT
  INFAQ
  QURBAN
}

enum TransactionPaymentStatus {
  PENDING
  DP
  LUNAS
  GAGAL
}

enum HewanType {
  SAPI
  KAMBING
}

enum HewanBatchStatus {
  TERSEDIA
  PENUH
  SELESAI
}

enum SlotStatus {
  TERSEDIA
  TERISI
  DIBATALKAN
}

enum Kepemilikan {
  INDIVIDU
  KOLEKTIF
}

enum OpsiPesan {
  PASRAH
  AMBIL_SENDIRI
}

enum MetodeBayar {
  TUNAI
  TRANSFER
  QRIS
  VA
}

enum QurbanPaymentStatus {
  BELUM_BAYAR
  DP
  LUNAS
}

enum PermohonanStatus {
  DIAJUKAN
  DISETUJUI
  DITOLAK
  DISALURKAN
}

enum EducationType {
  ARTIKEL
  VIDEO
}

enum ChatbotRole {
  USER
  ASSISTANT
}

enum ChatbotDomain {
  WAKAF_PRODUKTIF
}

enum ZakatType {
  FITRAH
  MAAL_PENGHASILAN
  FIDYAH
  KAFARAT
  EMAS
  PERUSAHAAN
  PERTANIAN
}

enum ZakatPaymentMethod {
  TUNAI
  TRANSFER
  BERAS
}

enum ZakatOrderStatus {
  MENUNGGU_VERIFIKASI
  TERVERIFIKASI
  DITOLAK
}

enum Asnaf {
  FAKIR
  MISKIN
  AMIL
  MUALLAF
  RIQAB
  GHARIMIN
  FISABILILLAH
  IBNU_SABIL
}

enum ZakatDistributionStatus {
  TERSALURKAN
  DIBATALKAN
}

enum GoldPriceSource {
  LIVE_API
  MANUAL_FALLBACK
}

enum BentukWakaf {
  UANG
  BARANG
}

enum WaqfOrderStatus {
  MENUNGGU_VERIFIKASI
  TERVERIFIKASI
  DITOLAK
}

// ============================================================
// MODELS
// ============================================================

model User {
  id           String   @id @default(uuid())
  email        String?  @unique
  phone        String?  @unique
  passwordHash String   @map("password_hash")
  name         String
  role         Role     @default(WAKIF)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens                   RefreshToken[]
  nadzirProfile                   NadzirProfile?                    @relation("NadzirUser")
  verifiedNadzirs                 NadzirProfile[]                   @relation("VerifiedByAdmin")
  createdProgressReports          ProgramProgressReport[]
  requestedWithdrawals            FundWithdrawalRequest[]           @relation("RequestedBy")
  approvedWithdrawals            FundWithdrawalRequest[]           @relation("ApprovedBy")
  waqfOrders                      WaqfOrder[]                       @relation("WaqfOrderWakif")
  waqfOrdersEntered               WaqfOrder[]                       @relation("WaqfOrderAmil")
  transactions                    Transaction[]
  zakatCalculations               ZakatCalculation[]
  zakatOrders                     ZakatOrder[]                      @relation("ZakatOrderMuzakki")
  zakatOrdersEntered              ZakatOrder[]                      @relation("ZakatOrderAmil")
  zakatDistributions              ZakatDistribution[]               @relation("DistributedByAmil")
  qurbanOrders                    QurbanOrder[]                     @relation("QurbanOrderWakif")
  petugasLapanganProfile          PetugasLapanganProfile?
  verifiedSetoran                 SetoranPetugasLapangan[]          @relation("VerifiedSetoranByAdmin")
  approvedPermohonanInstitusional PermohonanPenyaluranInstitusional[] @relation("ApprovedPermohonanByAdmin")
  quizAttempts                    QuizAttempt[]
  gamificationPointLedgers        GamificationPointLedger[]
  chatbotConversations            ChatbotConversation[]
  notifications                   Notification[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

model NadzirProfile {
  id                String             @id @default(uuid())
  userId            String             @unique @map("user_id")
  user              User               @relation("NadzirUser", fields: [userId], references: [id])
  kategori          NadzirKategori     @map("kategori")
  namaLembaga       String?            @map("nama_lembaga")
  nomorRekeningBank String?            @map("nomor_rekening_bank")
  namaBank          String?            @map("nama_bank")
  statusVerifikasi  VerificationStatus @default(PENDING) @map("status_verifikasi")
  verifiedById      String?            @map("verified_by_id")
  verifiedBy        User?              @relation("VerifiedByAdmin", fields: [verifiedById], references: [id])
  verifiedAt        DateTime?          @map("verified_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  documents    NadzirDocument[]
  waqfPrograms WaqfProgram[]

  @@map("nadzir_profiles")
}

model NadzirDocument {
  id                 String             @id @default(uuid())
  nadzirProfileId    String             @map("nadzir_profile_id")
  nadzirProfile      NadzirProfile      @relation(fields: [nadzirProfileId], references: [id])
  tipeDokumen        NadzirDocumentType @map("tipe_dokumen")
  fileUrl            String?            @map("file_url")
  fileDeletedAt      DateTime?          @map("file_deleted_at")
  ocrExtractedNik    String?            @map("ocr_extracted_nik")
  ocrExtractedNama   String?            @map("ocr_extracted_nama")
  ocrConfidenceScore Decimal?           @map("ocr_confidence_score") @db.Decimal(5, 2)
  reviewedManually   Boolean            @default(false) @map("reviewed_manually")
  createdAt          DateTime           @default(now()) @map("created_at")

  @@map("nadzir_documents")
}

model WaqfProgram {
  id                  String        @id @default(uuid())
  nadzirProfileId     String        @map("nadzir_profile_id")
  nadzirProfile       NadzirProfile @relation(fields: [nadzirProfileId], references: [id])
  judul               String        @map("judul")
  kategori            String?       @map("kategori")
  deskripsi           String?       @map("deskripsi")
  targetDana          Decimal       @map("target_dana") @db.Decimal(18, 2)
  durasiHari          Int?          @map("durasi_hari")
  bannerUrl           String?       @map("banner_url")
  jenisWakaf          WaqfType      @map("jenis_wakaf")
  status              WaqfStatus    @default(DRAFT) @map("status")
  rabDocumentUrl      String?       @map("rab_document_url")
  dokumenLegalitasUrl String?       @map("dokumen_legalitas_url")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  principalLedger          WaqfPrincipalLedger?
  progressReports          ProgramProgressReport[]
  withdrawalRequests       FundWithdrawalRequest[]
  waqfOrders               WaqfOrder[]
  mauqufAlaihDistributions MauqufAlaihDistribution[]

  @@map("waqf_programs")
}

model WaqfPrincipalLedger {
  id                        String      @id @default(uuid())
  waqfProgramId             String      @unique @map("waqf_program_id")
  waqfProgram               WaqfProgram @relation(fields: [waqfProgramId], references: [id])
  pokokDanaTerkumpul        Decimal     @default(0) @map("pokok_dana_terkumpul") @db.Decimal(18, 2)
  hasilInvestasiTersalurkan Decimal     @default(0) @map("hasil_investasi_tersalurkan") @db.Decimal(18, 2)
  updatedAt                 DateTime    @updatedAt @map("updated_at")

  @@map("waqf_principal_ledgers")
}

model ProgramProgressReport {
  id              String      @id @default(uuid())
  waqfProgramId   String      @map("waqf_program_id")
  waqfProgram     WaqfProgram @relation(fields: [waqfProgramId], references: [id])
  persentaseFisik Decimal?    @map("persentase_fisik") @db.Decimal(5, 2)
  deskripsi       String?     @map("deskripsi")
  kuitansiUrls    Json?       @map("kuitansi_urls")
  createdById     String      @map("created_by_id")
  createdBy       User        @relation(fields: [createdById], references: [id])
  createdAt       DateTime    @default(now()) @map("created_at")

  @@map("program_progress_reports")
}

model FundWithdrawalRequest {
  id            String           @id @default(uuid())
  waqfProgramId String           @map("waqf_program_id")
  waqfProgram   WaqfProgram      @relation(fields: [waqfProgramId], references: [id])
  amount        Decimal          @map("amount") @db.Decimal(18, 2)
  requestedById String           @map("requested_by_id")
  requestedBy   User             @relation("RequestedBy", fields: [requestedById], references: [id])
  approvedById  String?          @map("approved_by_id")
  approvedBy    User?            @relation("ApprovedBy", fields: [approvedById], references: [id])
  status        WithdrawalStatus @default(PENDING) @map("status")
  createdAt     DateTime         @default(now()) @map("created_at")

  mauqufAlaihDistributions MauqufAlaihDistribution[]

  @@map("fund_withdrawal_requests")
}

model WaqfOrder {
  id                  String          @id @default(uuid())
  nomorKwitansi       String          @unique @map("nomor_kwitansi")
  waqfProgramId       String          @map("waqf_program_id")
  waqfProgram         WaqfProgram     @relation(fields: [waqfProgramId], references: [id])
  wakifId             String?         @map("wakif_id")
  wakif               User?           @relation("WaqfOrderWakif", fields: [wakifId], references: [id])
  namaWakif           String          @map("nama_wakif")
  noTelepon           String?         @map("no_telepon")
  alamat              String?         @map("alamat")
  atasNamaWakif       String?         @map("atas_nama_wakif")
  bentukWakaf         BentukWakaf     @map("bentuk_wakaf")
  nominal             Decimal?        @map("nominal") @db.Decimal(18, 2)
  namaBarang          String?         @map("nama_barang")
  jumlahSatuan        Int?            @map("jumlah_satuan")
  nilaiTaksiranRupiah Decimal?        @map("nilai_taksiran_rupiah") @db.Decimal(18, 2)
  metodePembayaran    MetodeBayar?    @map("metode_pembayaran")
  status              WaqfOrderStatus @default(MENUNGGU_VERIFIKASI) @map("status")
  enteredByAmilId     String?         @map("entered_by_amil_id")
  enteredByAmil       User?           @relation("WaqfOrderAmil", fields: [enteredByAmilId], references: [id])
  transactionId       String?         @unique @map("transaction_id")
  transaction         Transaction?    @relation(fields: [transactionId], references: [id])
  nomorIkrarWakaf     String?         @map("nomor_ikrar_wakaf")
  dokumenAiwUrl       String?         @map("dokumen_aiw_url")
  createdAt           DateTime        @default(now()) @map("created_at")

  @@map("waqf_orders")
}

model MauqufAlaihDistribution {
  id                  String                 @id @default(uuid())
  waqfProgramId       String                 @map("waqf_program_id")
  waqfProgram         WaqfProgram            @relation(fields: [waqfProgramId], references: [id])
  withdrawalRequestId String?                @map("withdrawal_request_id")
  withdrawalRequest   FundWithdrawalRequest? @relation(fields: [withdrawalRequestId], references: [id])
  namaPenerimaManfaat String                 @map("nama_penerima_manfaat")
  kategoriPenerima    String?                @map("kategori_penerima")
  nominalDisalurkan   Decimal?               @map("nominal_disalurkan") @db.Decimal(18, 2)
  barangDisalurkan    String?                @map("barang_disalurkan")
  tanggalPenyaluran   DateTime?              @map("tanggal_penyaluran") @db.Date
  buktiPenyaluranUrl  String?                @map("bukti_penyaluran_url")
  notes               String?                @map("notes")

  @@map("mauquf_alaih_distributions")
}

model Transaction {
  id                      String                   @id @default(uuid())
  wakifId                 String                   @map("wakif_id")
  wakif                   User                     @relation(fields: [wakifId], references: [id])
  jenisTransaksi          TransactionType          @map("jenis_transaksi")
  amount                  Decimal                  @map("amount") @db.Decimal(18, 2)
  paymentMethod           String?                  @map("payment_method")
  paymentGatewayRef       String?                  @map("payment_gateway_ref")
  statusPembayaran        TransactionPaymentStatus @default(PENDING) @map("status_pembayaran")
  disbursementDestination String                   @map("disbursement_destination")
  createdAt               DateTime                 @default(now()) @map("created_at")

  waqfOrder   WaqfOrder?
  zakatOrder  ZakatOrder?
  qurbanOrder QurbanOrder?
  certificate Certificate?

  @@map("transactions")
}

model ZakatCalculation {
  id             String      @id @default(uuid())
  wakifId        String      @map("wakif_id")
  wakif          User        @relation(fields: [wakifId], references: [id])
  jenisZakat     ZakatType   @map("jenis_zakat")
  inputSnapshot  Json        @map("input_snapshot")
  nisabDigunakan Decimal?    @map("nisab_digunakan") @db.Decimal(18, 2)
  hasilKewajiban Decimal?    @map("hasil_kewajiban") @db.Decimal(18, 2)
  zakatOrderId   String?     @map("zakat_order_id")
  zakatOrder     ZakatOrder? @relation(fields: [zakatOrderId], references: [id])
  createdAt      DateTime    @default(now()) @map("created_at")

  @@map("zakat_calculations")
}

model ZakatOrder {
  id               String             @id @default(uuid())
  tahunHijriah     String?            @map("tahun_hijriah")
  nomorKwitansi    String             @unique @map("nomor_kwitansi")
  muzakkiId        String?            @map("muzakki_id")
  muzakki          User?              @relation("ZakatOrderMuzakki", fields: [muzakkiId], references: [id])
  namaMuzakki      String             @map("nama_muzakki")
  namaDizakatkan   String?            @map("nama_dizakatkan")
  noTelepon        String?            @map("no_telepon")
  alamat           String?            @map("alamat")
  isAnonymous      Boolean            @default(false) @map("is_anonymous")
  jenisZakat       ZakatType          @map("jenis_zakat")
  metodePembayaran ZakatPaymentMethod @map("metode_pembayaran")
  nominal          Decimal?           @map("nominal") @db.Decimal(18, 2)
  beratBerasKg     Decimal?           @map("berat_beras_kg") @db.Decimal(10, 2)
  jumlahJiwa       Int?               @map("jumlah_jiwa")
  buktiTransferUrl String?            @map("bukti_transfer_url")
  status           ZakatOrderStatus   @default(MENUNGGU_VERIFIKASI) @map("status")
  notes            String?            @map("notes")
  enteredByAmilId  String?            @map("entered_by_amil_id")
  enteredByAmil    User?              @relation("ZakatOrderAmil", fields: [enteredByAmilId], references: [id])
  transactionId    String?            @unique @map("transaction_id")
  transaction      Transaction?       @relation(fields: [transactionId], references: [id])
  createdAt        DateTime           @default(now()) @map("created_at")

  zakatCalculations ZakatCalculation[]

  @@map("zakat_orders")
}

model MustahiqProfile {
  id           String   @id @default(uuid())
  namaMustahiq String   @map("nama_mustahiq")
  kategoriAsnaf Asnaf   @map("kategori_asnaf")
  alamat       String?  @map("alamat")
  noTelepon    String?  @map("no_telepon")
  createdAt    DateTime @default(now()) @map("created_at")

  zakatDistributions ZakatDistribution[]

  @@map("mustahiq_profiles")
}

model ZakatDistribution {
  id                  String                  @id @default(uuid())
  mustahiqId          String                  @map("mustahiq_id")
  mustahiq            MustahiqProfile         @relation(fields: [mustahiqId], references: [id])
  jenisZakat          ZakatType               @map("jenis_zakat")
  nominal             Decimal?                @map("nominal") @db.Decimal(18, 2)
  beratBerasKg        Decimal?                @map("berat_beras_kg") @db.Decimal(10, 2)
  buktiPenerimaanUrl  String?                 @map("bukti_penerimaan_url")
  status              ZakatDistributionStatus @default(TERSALURKAN) @map("status")
  notes               String?                 @map("notes")
  distributedByAmilId String                  @map("distributed_by_amil_id")
  distributedByAmil   User                    @relation("DistributedByAmil", fields: [distributedByAmilId], references: [id])
  createdAt           DateTime                @default(now()) @map("created_at")

  @@map("zakat_distributions")
}

model ZakatFitrahConfig {
  id                   String   @id @default(uuid())
  jenisBeras           String   @map("jenis_beras")
  konversiHargaPerJiwa Decimal  @map("konversi_harga_per_jiwa") @db.Decimal(18, 2)
  referensiSk          String?  @map("referensi_sk")
  tahunBerlaku         String?  @map("tahun_berlaku")
  isActive             Boolean  @default(true) @map("is_active")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("zakat_fitrah_config")
}

model ZakatGoldPriceHistory {
  id           String           @id @default(uuid())
  pricePerGram Decimal          @map("price_per_gram") @db.Decimal(18, 2)
  source       GoldPriceSource  @map("source")
  fetchedAt    DateTime         @default(now()) @map("fetched_at")

  @@map("zakat_gold_price_history")
}

model HewanBatch {
  id           String           @id @default(uuid())
  jenisHewan   HewanType        @map("jenis_hewan")
  totalSlot    Int              @default(1) @map("total_slot")
  hargaPerSlot Decimal          @map("harga_per_slot") @db.Decimal(18, 2)
  status       HewanBatchStatus @default(TERSEDIA) @map("status")
  createdAt    DateTime         @default(now()) @map("created_at")

  qurbanAnimalSlots QurbanAnimalSlot[]

  @@map("hewan_batches")
}

model QurbanAnimalSlot {
  id            String      @id @default(uuid())
  hewanBatchId  String      @map("hewan_batch_id")
  hewanBatch    HewanBatch  @relation(fields: [hewanBatchId], references: [id])
  nomorSlot     Int         @map("nomor_slot")
  qurbanOrderId String?     @map("qurban_order_id")
  qurbanOrder   QurbanOrder? @relation(fields: [qurbanOrderId], references: [id])
  status        SlotStatus  @default(TERSEDIA) @map("status")

  @@unique([hewanBatchId, nomorSlot])
  @@map("qurban_animal_slots")
}

model QurbanOrder {
  id                 String                 @id @default(uuid())
  wakifId            String?                @map("wakif_id")
  wakif              User?                  @relation("QurbanOrderWakif", fields: [wakifId], references: [id])
  namaPengqurban     String                 @map("nama_pengqurban")
  teleponPengqurban  String?                @map("telepon_pengqurban")
  alamatPengqurban   String?                @map("alamat_pengqurban")
  jenisHewan         HewanType              @map("jenis_hewan")
  tipeKepemilikan    Kepemilikan            @map("tipe_kepemilikan")
  opsiPesan          OpsiPesan              @default(PASRAH) @map("opsi_pesan")
  metodePembayaran   MetodeBayar            @map("metode_pembayaran")
  statusPembayaran   QurbanPaymentStatus    @default(BELUM_BAYAR) @map("status_pembayaran")
  totalHarga         Decimal                @map("total_harga") @db.Decimal(18, 2)
  sisaTagihan        Decimal                @default(0) @map("sisa_tagihan") @db.Decimal(18, 2)
  enteredByPetugasId String?                @map("entered_by_petugas_id")
  enteredByPetugas   PetugasLapanganProfile? @relation(fields: [enteredByPetugasId], references: [id])
  transactionId      String?                @unique @map("transaction_id")
  transaction        Transaction?           @relation(fields: [transactionId], references: [id])
  createdAt          DateTime               @default(now()) @map("created_at")

  qurbanAnimalSlots             QurbanAnimalSlot[]
  qurbanDistributionReports     QurbanDistributionReport[]
  setoranQurbanOrderLinks       SetoranQurbanOrderLink[]
  qurbanDistributionAllocations QurbanDistributionAllocation[]

  @@map("qurban_orders")
}

model QurbanDistributionReport {
  id               String      @id @default(uuid())
  qurbanOrderId    String      @map("qurban_order_id")
  qurbanOrder      QurbanOrder @relation(fields: [qurbanOrderId], references: [id])
  buktiFotoUrl     String?     @map("bukti_foto_url")
  lokasiPenyaluran String?     @map("lokasi_penyaluran")
  createdAt        DateTime    @default(now()) @map("created_at")

  @@map("qurban_distribution_reports")
}

model PetugasLapanganProfile {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  user         User     @relation(fields: [userId], references: [id])
  wilayahTugas String?  @map("wilayah_tugas")
  noHp         String?  @map("no_hp")
  createdAt    DateTime @default(now()) @map("created_at")

  enteredQurbanOrders    QurbanOrder[]
  setoranPetugasLapangan SetoranPetugasLapangan[]

  @@map("petugas_lapangan_profiles")
}

model SetoranPetugasLapangan {
  id                String                 @id @default(uuid())
  petugasId         String                 @map("petugas_id")
  petugas           PetugasLapanganProfile @relation(fields: [petugasId], references: [id])
  nomorUrut         Int?                   @map("nomor_urut")
  tanggal           DateTime               @map("tanggal") @db.Date
  jumlahSetor       Decimal                @map("jumlah_setor") @db.Decimal(18, 2)
  keterangan        String?                @map("keterangan")
  verifiedByAdminId String?                @map("verified_by_admin_id")
  verifiedByAdmin   User?                  @relation("VerifiedSetoranByAdmin", fields: [verifiedByAdminId], references: [id])
  verifiedAt        DateTime?              @map("verified_at")
  createdAt         DateTime               @default(now()) @map("created_at")

  setoranQurbanOrderLinks SetoranQurbanOrderLink[]

  @@map("setoran_petugas_lapangan")
}

model SetoranQurbanOrderLink {
  id            String                 @id @default(uuid())
  setoranId     String                 @map("setoran_id")
  setoran       SetoranPetugasLapangan @relation(fields: [setoranId], references: [id])
  qurbanOrderId String                 @map("qurban_order_id")
  qurbanOrder   QurbanOrder            @relation(fields: [qurbanOrderId], references: [id])

  @@unique([setoranId, qurbanOrderId])
  @@map("setoran_qurban_order_links")
}

model PermohonanPenyaluranInstitusional {
  id                   String           @id @default(uuid())
  namaPemohon          String           @map("nama_pemohon")
  namaLembaga          String?          @map("nama_lembaga")
  alamatPemohon        String?          @map("alamat_pemohon")
  nomorSuratPermohonan String?          @map("nomor_surat_permohonan")
  kontak               String?          @map("kontak")
  penanggungJawab      String?          @map("penanggung_jawab")
  nomorRekeningPemohon String?          @map("nomor_rekening_pemohon")
  namaBank             String?          @map("nama_bank")
  status               PermohonanStatus @default(DIAJUKAN) @map("status")
  approvedByAdminId    String?          @map("approved_by_admin_id")
  approvedByAdmin      User?            @relation("ApprovedPermohonanByAdmin", fields: [approvedByAdminId], references: [id])
  createdAt            DateTime         @default(now()) @map("created_at")

  qurbanDistributionAllocations QurbanDistributionAllocation[]

  @@map("permohonan_penyaluran_institusional")
}

model QurbanDistributionAllocation {
  id            String                             @id @default(uuid())
  permohonanId  String?                            @map("permohonan_id")
  permohonan    PermohonanPenyaluranInstitusional? @relation(fields: [permohonanId], references: [id])
  qurbanOrderId String?                            @map("qurban_order_id")
  qurbanOrder   QurbanOrder?                       @relation(fields: [qurbanOrderId], references: [id])
  jumlahBagian  Decimal?                           @map("jumlah_bagian") @db.Decimal(10, 2)
  tanggalSalur  DateTime?                          @map("tanggal_salur") @db.Date
  buktiFotoUrl  String?                            @map("bukti_foto_url")
  createdAt     DateTime                           @default(now()) @map("created_at")

  @@map("qurban_distribution_allocations")
}

model Certificate {
  id                 String      @id @default(uuid())
  transactionId      String      @unique @map("transaction_id")
  transaction        Transaction @relation(fields: [transactionId], references: [id])
  jenisSertifikat    String?     @map("jenis_sertifikat")
  nomorInternalAmwal String      @unique @map("nomor_internal_amwal")
  nomorRegistrasiBwi String?     @map("nomor_registrasi_bwi")
  pdfUrl             String?     @map("pdf_url")
  issuedAt           DateTime    @default(now()) @map("issued_at")

  @@map("certificates")
}

model EducationContent {
  id        String        @id @default(uuid())
  judul     String        @map("judul")
  tipe      EducationType @map("tipe")
  kontenUrl String?       @map("konten_url")
  kategori  String?       @map("kategori")
  createdAt DateTime      @default(now()) @map("created_at")

  quizzes Quiz[]

  @@map("education_contents")
}

model Quiz {
  id                 String            @id @default(uuid())
  educationContentId String?           @map("education_content_id")
  educationContent   EducationContent? @relation(fields: [educationContentId], references: [id])
  judul              String            @map("judul")
  createdAt          DateTime          @default(now()) @map("created_at")

  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@map("quizzes")
}

model QuizQuestion {
  id           String @id @default(uuid())
  quizId       String @map("quiz_id")
  quiz         Quiz   @relation(fields: [quizId], references: [id])
  pertanyaan   String @map("pertanyaan")
  opsiJawaban  Json   @map("opsi_jawaban")
  jawabanBenar String @map("jawaban_benar")

  @@map("quiz_questions")
}

model QuizAttempt {
  id        String   @id @default(uuid())
  quizId    String   @map("quiz_id")
  quiz      Quiz     @relation(fields: [quizId], references: [id])
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  skor      Decimal? @map("skor") @db.Decimal(5, 2)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("quiz_attempts")
}

model GamificationPointLedger {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id])
  activityType String   @map("activity_type")
  pointsEarned Int      @map("points_earned")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("gamification_point_ledgers")
}

model ChatbotConversation {
  id          String        @id @default(uuid())
  userId      String        @map("user_id")
  user        User          @relation(fields: [userId], references: [id])
  domainScope ChatbotDomain @default(WAKAF_PRODUKTIF) @map("domain_scope")
  createdAt   DateTime      @default(now()) @map("created_at")

  messages ChatbotMessage[]

  @@map("chatbot_conversations")
}

model ChatbotMessage {
  id             String              @id @default(uuid())
  conversationId String              @map("conversation_id")
  conversation   ChatbotConversation @relation(fields: [conversationId], references: [id])
  role           ChatbotRole         @map("role")
  content        String              @map("content")
  citedSources   Json?               @map("cited_sources")
  createdAt      DateTime            @default(now()) @map("created_at")

  @@map("chatbot_messages")
}

model Notification {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id])
  type            String   @map("type")
  title           String   @map("title")
  body            String?  @map("body")
  isRead          Boolean  @default(false) @map("is_read")
  relatedEntityId String?  @map("related_entity_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("notifications")
}
